MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=timecloud_fresh
AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
APP_ORIGIN=http://localhost:5173
PORT=10000

# API_ORIGIN defaults to APP_ORIGIN; override only if needed.

# Configure both only when enabling password-reset email.
SMTP_URL=
SMTP_FROM=
