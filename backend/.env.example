MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=timecloud_fresh
AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
# Required in production; use the same random 64-character hex value as Vercel.
# Local development does not require this value.
TIMECLOUD_GATEWAY_SECRET=
# Generate a random 32-byte hexadecimal key for server-side financial-data encryption.
# Keep this backend-only key backed up securely; changing or losing it makes stored financial data unreadable.
PRIVATE_DATA_ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:10000
PORT=10000

# Configure both only when enabling password-reset email.
SMTP_URL=
SMTP_FROM=
